# ClaimForge Environment Variables

# Project Information
ENVIRONMENT=development
PROJECT_NAME="ClaimForge API"
VERSION=1.0.0

# Database Configuration (defaults to local SQLite if left empty)
DATABASE_URL=sqlite+aiosqlite:///./claimforge.db

# Storage Mode: "local" (default) or "supabase"
STORAGE_MODE=local
UPLOAD_DIR=./uploads

# Supabase (Optional - only required if STORAGE_MODE=supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_BUCKET=claim-documents

# AI Provider Configuration (defaults to "rule_based" if no API key is set)
# AI_PROVIDER can be "rule_based", "gemini", "openai", or "anthropic"
AI_PROVIDER=rule_based
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# ANTHROPIC_API_KEY=sk-ant-...

# Frontend API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
