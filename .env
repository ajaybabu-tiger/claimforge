# ClaimForge Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="ClaimForge API"
VERSION=1.0.0

# Database Configuration (local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./claimforge.db

# Storage Mode: "local"
STORAGE_MODE=local
UPLOAD_DIR=./uploads

# AI Provider Configuration (rule-based deterministic fallback - no API keys required)
AI_PROVIDER=rule_based

# Frontend API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
